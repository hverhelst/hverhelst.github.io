{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://www.hugoverhelst.nl/schemas/publications.schema.json",
	"title": "Publications",
	"description": "data/publications.json, rendered by layouts/partials/publicationsSummary.html. The partial and the LaTeX CV both dispatch on `entry-type` with no fallback, so an unrecognised value silently drops the publication from both.",
	"type": "array",
	"items": { "$ref": "#/$defs/item" },
	"$defs": {
		"item": {
			"type": "object",
			"additionalProperties": false,
			"required": ["cite-key", "entry-type", "description", "featured"],
			"properties": {
				"cite-key": {
					"type": "string",
					"pattern": "^[A-Za-z0-9]*$",
					"description": "Also the basename of the figure in static/media."
				},
				"entry-type": {
					"enum": ["article", "inproceeding", "incollection", "thesis", "unpublished"]
				},
				"description": { "$ref": "#/$defs/description" },
				"featured": { "type": "boolean" }
			},
			"allOf": [
				{
					"if": { "properties": { "entry-type": { "const": "article" } }, "required": ["entry-type"] },
					"then": {
						"properties": {
							"description": { "required": ["author", "title", "journal", "year", "url"] }
						}
					}
				},
				{
					"if": { "properties": { "entry-type": { "const": "inproceeding" } }, "required": ["entry-type"] },
					"then": {
						"properties": {
							"description": { "required": ["author", "title", "booktitle", "year", "url"] }
						}
					}
				},
				{
					"if": { "properties": { "entry-type": { "const": "incollection" } }, "required": ["entry-type"] },
					"then": {
						"properties": {
							"description": { "required": ["author", "title", "booktitle", "editor", "year", "url"] }
						}
					}
				},
				{
					"if": { "properties": { "entry-type": { "const": "thesis" } }, "required": ["entry-type"] },
					"then": {
						"properties": {
							"description": { "required": ["author", "title", "school", "degree", "date", "url"] }
						}
					}
				},
				{
					"if": { "properties": { "entry-type": { "const": "unpublished" } }, "required": ["entry-type"] },
					"then": {
						"properties": {
							"description": { "required": ["author", "title", "year", "url"] }
						}
					}
				}
			]
		},
		"description": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"author": {
					"type": "string",
					"minLength": 1,
					"description": "Initials before surnames, comma separated: H. M. Verhelst, M. Möller."
				},
				"title": { "type": "string", "minLength": 1 },
				"journal": { "type": "string", "minLength": 1 },
				"booktitle": { "type": "string", "minLength": 1 },
				"editor": { "type": "string", "minLength": 1 },
				"series": { "type": "string", "minLength": 1 },
				"school": { "type": "string", "minLength": 1 },
				"degree": { "type": "string", "minLength": 1 },
				"publisher": { "type": "string", "minLength": 1 },
				"volume": { "type": "string", "minLength": 1 },
				"issue": { "type": "string", "minLength": 1 },
				"number": { "type": "string", "minLength": 1 },
				"pages": { "type": "string", "minLength": 1 },
				"year": { "type": "string", "pattern": "^\\d{4}$" },
				"date": {
					"type": "string",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
					"format": "date",
					"description": "Defence date; theses are sorted and dated on this."
				},
				"eprint": {
					"type": "string",
					"minLength": 1,
					"description": "Preprint identifier, e.g. arXiv:2508.10648."
				},
				"url": { "type": "string", "pattern": "^https?://" },
				"doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/" },
				"image": { "type": "string", "pattern": "^(media/|https?://)" },
				"imageCaption": { "type": "string", "minLength": 1 },
				"abstract": { "type": "string", "minLength": 1 }
			}
		}
	}
}
