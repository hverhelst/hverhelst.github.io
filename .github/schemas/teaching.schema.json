{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://www.hugoverhelst.nl/schemas/teaching.schema.json",
	"title": "Teaching",
	"description": "data/teaching.json, rendered by layouts/partials/teachingSummary.html. The partial groups by `level` with no fallback, so an unrecognised value silently drops the entry.",
	"type": "array",
	"items": { "$ref": "#/$defs/item" },
	"$defs": {
		"date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
		"optionalDate": {
			"anyOf": [
				{ "const": "" },
				{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" }
			]
		},
		"item": {
			"type": "object",
			"additionalProperties": false,
			"required": ["degree", "level", "course", "university", "start", "role", "featured"],
			"properties": {
				"degree": { "type": "string", "minLength": 1, "description": "The programme the course belongs to." },
				"level": { "enum": ["BSc", "MSc", "PhD"] },
				"course": { "type": "string", "minLength": 1 },
				"university": { "type": "string", "minLength": 1 },
				"start": { "$ref": "#/$defs/date" },
				"end": { "$ref": "#/$defs/optionalDate" },
				"duration": { "type": "string", "minLength": 1 },
				"url": { "type": "string", "pattern": "^https?://" },
				"role": { "type": "string", "minLength": 1 },
				"featured": { "type": "boolean" }
			}
		}
	}
}
