{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://www.hugoverhelst.nl/schemas/supervision.schema.json",
	"title": "Supervision",
	"description": "data/supervision.json, rendered by layouts/partials/supervisionSummary.html. The partial groups by `level` with no fallback, so an unrecognised value silently drops the entry.",
	"type": "array",
	"items": { "$ref": "#/$defs/item" },
	"$defs": {
		"item": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "university", "degree", "title", "level", "graduation", "role", "featured"],
			"properties": {
				"name": { "type": "string", "minLength": 1, "description": "The student." },
				"university": { "type": "string", "minLength": 1 },
				"degree": { "type": "string", "minLength": 1, "description": "The programme the student is enrolled in." },
				"title": { "type": "string", "minLength": 1, "description": "Thesis title." },
				"level": { "enum": ["BSc", "MSc", "PhD"] },
				"graduation": {
					"type": "string",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
					"format": "date",
					"description": "The expected date for an ongoing project."
				},
				"cosupervisors": { "type": "string" },
				"role": { "type": "string", "minLength": 1, "description": "Your role, e.g. Daily supervisor." },
				"url": { "type": "string", "pattern": "^https?://" },
				"featured": { "type": "boolean" }
			}
		}
	}
}
