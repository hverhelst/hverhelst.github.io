{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://www.hugoverhelst.nl/schemas/conferences.schema.json",
	"title": "Conference contributions",
	"description": "data/conferences.json, rendered by layouts/partials/conferencesSummary.html. Both the partial and the LaTeX CV split entries on `invited`, so an entry missing that key is silently dropped from both.",
	"type": "array",
	"items": { "$ref": "#/$defs/item" },
	"$defs": {
		"date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
		"optionalDate": {
			"anyOf": [
				{ "const": "" },
				{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" }
			]
		},
		"url": { "type": "string", "pattern": "^https?://" },
		"image": { "type": "string", "pattern": "^(media/|https?://)" },
		"item": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "location", "title", "start", "end", "featured", "invited"],
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"location": { "type": "string", "minLength": 1 },
				"title": { "type": "string", "minLength": 1 },
				"start": { "$ref": "#/$defs/date" },
				"end": {
					"$ref": "#/$defs/optionalDate",
					"description": "Empty for a single-day event, but always present."
				},
				"url": { "$ref": "#/$defs/url" },
				"details": { "type": "string" },
				"image": { "$ref": "#/$defs/image" },
				"imageCaption": { "type": "string" },
				"featured": { "type": "boolean" },
				"invited": { "type": "boolean" }
			}
		}
	}
}
