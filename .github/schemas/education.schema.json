{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://www.hugoverhelst.nl/schemas/education.schema.json",
	"title": "Education",
	"description": "data/education.json, rendered by layouts/partials/educationSummary.html.",
	"type": "array",
	"items": { "$ref": "#/$defs/item" },
	"$defs": {
		"date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
		"optionalDate": {
			"anyOf": [
				{ "const": "" },
				{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" }
			]
		},
		"item": {
			"type": "object",
			"additionalProperties": false,
			"required": ["school", "degree", "start", "end", "featured"],
			"properties": {
				"school": { "type": "string", "minLength": 1 },
				"schoollink": { "type": "string", "pattern": "^https?://" },
				"degree": { "type": "string", "minLength": 1 },
				"major": { "type": "string" },
				"notes": { "type": "string", "description": "Distinctions, e.g. Cum Laude." },
				"start": { "$ref": "#/$defs/date" },
				"end": { "$ref": "#/$defs/optionalDate" },
				"thesis": { "type": "string" },
				"thesislink": { "type": "string", "pattern": "^https?://" },
				"supervisors": { "type": "string" },
				"featured": { "type": "boolean" }
			}
		}
	}
}
