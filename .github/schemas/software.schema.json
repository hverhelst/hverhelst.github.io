{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://www.hugoverhelst.nl/schemas/software.schema.json",
	"title": "Software",
	"description": "data/software.json, rendered by layouts/partials/softwareSummary.html.",
	"type": "array",
	"items": { "$ref": "#/$defs/item" },
	"$defs": {
		"url": { "type": "string", "pattern": "^https?://" },
		"image": { "type": "string", "pattern": "^(media/|https?://)" },
		"item": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "role", "description", "url", "featured"],
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"role": { "type": "string", "minLength": 1 },
				"description": { "type": "string", "minLength": 1 },
				"url": { "$ref": "#/$defs/url" },
				"doi": {
					"type": "string",
					"pattern": "^10\\.\\d{4,9}/",
					"description": "Bare DOI, without the https://doi.org/ prefix."
				},
				"details": { "type": "string" },
				"image": { "$ref": "#/$defs/image" },
				"imageCaption": { "type": "string" },
				"featured": { "type": "boolean" }
			}
		}
	}
}
