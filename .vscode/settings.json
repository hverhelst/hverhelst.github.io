		{ "fileMatch": ["/data/mydata.json"], "url": "./.github/schemas/mydata.schema.json" },
		{ "fileMatch": ["/data/news.json"], "url": "./.github/schemas/news.schema.json" },
		{ "fileMatch": ["/data/publications.json"], "url": "./.github/schemas/publications.schema.json" },
		{ "fileMatch": ["/data/software.json"], "url": "./.github/schemas/software.schema.json" },
		{ "fileMatch": ["/data/supervision.json"], "url": "./.github/schemas/supervision.schema.json" },
		{ "fileMatch": ["/data/teaching.json"], "url": "./.github/schemas/teaching.schema.json" }
